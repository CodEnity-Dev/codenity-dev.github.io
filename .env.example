# GitHub OAuth Configuration
# Copy this file to .env for local development
# For production, set these in Netlify Dashboard: Site Settings > Environment Variables

# GitHub OAuth App Credentials
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# Site Origin (your main site URL)
ORIGIN=https://codenity-dev.github.io

# Additional Configuration
RUBY_VERSION=3.1.7
NODE_VERSION=18

# IMPORTANT NOTES:
# 1. Never commit .env file to version control
# 2. GitHub OAuth App callback URL must be: https://codenity-dev.github.io/admin/callback.html
# 3. Update admin/config.yml base_url to match your Netlify site URL
# 4. For local development, use Netlify Dev: netlify dev

---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ "/feed.xml" | prepend: site.baseurl | prepend: site.url }}" rel="self" type="application/rss+xml"/>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    <language>en-US</language>
    <managingEditor>{{ site.email | xml_escape }} (CodEnity Team)</managingEditor>
    <webMaster>{{ site.email | xml_escape }} (CodEnity Team)</webMaster>
    <copyright>Copyright © {{ site.time | date: '%Y' }} CodEnity. All rights reserved.</copyright>
    <category>Technology</category>
    <category>Programming</category>
    <category>Browser Extensions</category>
    <category>Web Development</category>
    <ttl>60</ttl>
    <image>
      <url>{{ site.url }}{{ site.baseurl }}/assets/images/ce.png</url>
      <title>{{ site.title | xml_escape }}</title>
      <link>{{ site.url }}{{ site.baseurl }}/</link>
      <width>144</width>
      <height>144</height>
      <description>{{ site.title | xml_escape }} - {{ site.description | xml_escape }}</description>
    </image>
    
    {% for post in site.posts limit:20 %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <description>{{ post.excerpt | default: post.description | strip_html | xml_escape }}</description>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <link>{{ post.url | prepend: site.baseurl | prepend: site.url }}</link>
        <guid isPermaLink="true">{{ post.url | prepend: site.baseurl | prepend: site.url }}</guid>
        <author>{{ site.email | xml_escape }} (CodEnity Team)</author>
        
        {% if post.categories %}
          {% for category in post.categories %}
            <category>{{ category | xml_escape }}</category>
          {% endfor %}
        {% endif %}
        
        {% if post.tags %}
          {% for tag in post.tags %}
            <category>{{ tag | xml_escape }}</category>
          {% endfor %}
        {% endif %}
        
        {% if post.image %}
          <enclosure url="{{ post.image | prepend: site.baseurl | prepend: site.url }}" type="image/jpeg" length="0"/>
        {% endif %}
      </item>
    {% endfor %}
  </channel>
</rss>